# Backend API — replace with your machine's LAN IP for physical devices,
# 10.0.2.2 for Android emulator, or localhost for iOS sim / web.
EXPO_PUBLIC_API_BASE_URL=http://YOUR-LAN-IP:5000/api

# Firebase client config — copy from Firebase Console → Project Settings → Your apps → Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
